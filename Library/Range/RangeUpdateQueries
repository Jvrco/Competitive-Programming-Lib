#include <bits/stdc++.h> 
using namespace std;
 
#define endl '\n'             
#define MOD 1000000007         
typedef long long ll;          
 
const int MAXV = 200000;       
const ll INF = LLONG_MAX;     
 
ll tree[MAXV + 1];
int arr[MAXV + 1];
int n, q;
 
void update(int idx, ll val) {
    while (idx <= n) {
        tree[idx] += val;           
        idx += idx & -idx;        
    }
}
 
ll prefixs(int idx) {
    ll sum = 0;
    while (idx > 0) {
        sum += tree[idx];          
        idx -= idx & -idx;         
    }
    return sum;
}
 
ll rangesum(int a, int b) {
    return prefixs(b) - prefixs(a - 1);
}
 
int main() {
    ios::sync_with_stdio(false);    
    cin.tie(NULL);                
 
    cin >> n >> q;                 
 
    for (int i = 1; i <= n; i++) {
        cin >> arr[i];              
    }
 
    while (q--) {
        int t, a, b;
        cin >> t;
        if(t == 1){
            ll u;
            cin >> a >> b >> u;
            update(a,u);
            if(b + 1 <=n) update(b+1,-u);
        }
        else{
                ll k;
                cin >> k;
                cout << arr[k] + prefixs(k) << endl;
        }
    }
 
    return 0;
}
